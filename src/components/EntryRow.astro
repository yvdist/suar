---
import type { CollectionEntry } from "astro:content";
import VerificationStamp from "./VerificationStamp.astro";
import { formatPrice } from "../lib/price";

interface Props {
  entry: CollectionEntry<"services">;
}

const { entry } = Astro.props;
const data = entry.data;

const isFree = data.price_min === 0;
const priceClass = isFree ? "text-accent" : "text-muted";

const typeLabels: Record<string, string> = {
  psychologist: "Psikolog",
  psychiatrist: "Psikiater",
  counseling: "Konseling",
  community: "Komunitas",
  hotline: "Hotline",
};

const location = [data.city, data.district].filter(Boolean).join(", ");
const description = [typeLabels[data.type] ?? data.type, location, data.hours]
  .filter((part) => part && part.trim().length > 0)
  .join(" · ");

const pricingLabels: Record<string, string> = {
  free: "Gratis",
  bpjs: "Ditanggung BPJS",
  "sliding-scale": "Sliding scale",
  "fixed-rate": "Tarif tetap",
};

interface Badge {
  text: string;
  important: boolean;
}

const allBadges: Badge[] = [
  ...(data.status === "closed"
    ? [{ text: "Sudah tutup", important: true } as Badge]
    : [{ text: pricingLabels[data.pricing] ?? data.pricing, important: true } as Badge]),
  ...(!data.needs_referral ? [{ text: "Tanpa rujukan", important: false } as Badge] : []),
  ...(data.online ? [{ text: "Daring", important: false } as Badge] : []),
];
const badges = allBadges.slice(0, 3);
---

<li
  id={`entry-${entry.id}`}
  data-key={entry.id}
  data-name={data.name.toLowerCase()}
  data-district={(data.district ?? "").toLowerCase()}
  data-pricing={data.pricing}
  data-price={String(data.price_min)}
  data-type={data.type}
  data-online={data.online ? "1" : ""}
  data-in-person={data.in_person ? "1" : ""}
  data-no-referral={!data.needs_referral ? "1" : ""}
  data-no-appointment={!data.needs_appointment ? "1" : ""}
>
  <a
    href={`/services/${entry.id}`}
    class="block rounded-[8px] bg-surface p-[16px_18px] no-underline transition-colors hover:bg-shade focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-[17px] font-medium tracking-[-0.01em] text-ink">
        {data.name}
      </h2>
      <p class={`shrink-0 font-data text-xs font-normal ${priceClass}`}>
        {formatPrice(data)}
      </p>
    </div>

    {description && (
      <p class="mt-1 text-sm font-normal leading-relaxed text-muted">{description}</p>
    )}

    {badges.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-2">
        {badges.map((b) => (
          <span
            class={`inline-flex items-center rounded-[4px] px-[9px] py-[3px] text-xs font-normal leading-snug ${
              b.important ? "bg-free-bg text-free" : "bg-accent-bg text-muted"
            }`}
          >
            {b.text}
          </span>
        ))}
      </div>
    )}

    <div class="mt-3">
      <VerificationStamp lastVerified={data.last_verified} />
    </div>
  </a>
</li>
