---
import { statusKesegaran, formatTanggalPendek } from "../lib/verifikasi";

interface Props {
  lastVerified: Date;
}

const { lastVerified } = Astro.props;
const status = statusKesegaran(lastVerified);
const tanggal = formatTanggalPendek(lastVerified);

const titikClass =
  status === "segar" ? "bg-aksen" : status === "menua" ? "bg-gratis" : "bg-usang";
const teksClass = status === "usang" ? "text-usang" : "text-redup";
---

<div class="border-t border-garis pt-3">
  <p class={`flex items-center gap-2 font-data text-[11px] tracking-[0.03em] uppercase ${teksClass}`}>
    <span class={`inline-block h-[7px] w-[7px] shrink-0 rounded-full ${titikClass}`} aria-hidden="true"></span>
    <time datetime={lastVerified.toISOString()}>
      Dicek {tanggal}{status === "usang" ? " · Perlu dicek ulang" : ""}
    </time>
  </p>
</div>
