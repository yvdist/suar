---
import { freshnessStatus, formatShortDate } from "../lib/freshness";

interface Props {
  lastVerified: Date;
}

const { lastVerified } = Astro.props;
const status = freshnessStatus(lastVerified);
const date = formatShortDate(lastVerified);

const dotClass =
  status === "fresh" ? "bg-accent" : status === "aging" ? "bg-free" : "bg-stale";
const textClass = status === "stale" ? "text-stale" : "text-muted";
---

<div class="border-t border-line pt-3">
  <p class={`flex items-center gap-2 font-data text-[11px] tracking-[0.03em] uppercase ${textClass}`}>
    <span class={`inline-block h-[7px] w-[7px] shrink-0 rounded-full ${dotClass}`} aria-hidden="true"></span>
    <time datetime={lastVerified.toISOString()}>
      Dicek {date}{status === "stale" ? " · Perlu dicek ulang" : ""}
    </time>
  </p>
</div>
