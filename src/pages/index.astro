---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BarisEntri from "../components/BarisEntri.astro";
import Filter from "../components/Filter";

const semuaEntri = await getCollection("layanan");
const entri = [...semuaEntri].sort((a, b) => a.data.harga_min - b.data.harga_min);

const tanggalTerbaru = entri.reduce<Date | null>((terbaru, item) => {
  const t = item.data.last_verified;
  return !terbaru || t > terbaru ? t : terbaru;
}, null);
---

<Base
  title="Daftar layanan"
  description="Layanan kesehatan mental terjangkau di Bandung beserta biayanya."
>
  <div class="space-y-6">
    <div class="space-y-3">
      <h1 class="font-display text-[32px] font-medium leading-tight text-ink">
        Daftar layanan
      </h1>
      <p class="max-w-[60ch] text-base font-normal leading-relaxed text-ink">
        Layanan kesehatan mental di Bandung beserta biayanya.
      </p>
      <p class="font-data text-xs font-normal tracking-normal text-muted">
        {entri.length} layanan
        {tanggalTerbaru &&
          ` · diperbarui ${tanggalTerbaru.getDate()}/${tanggalTerbaru.getMonth() + 1}/${tanggalTerbaru.getFullYear()}`}
      </p>
    </div>

    <div class="flex flex-col gap-6 min-[900px]:flex-row min-[900px]:gap-8">
      <div class="min-[900px]:w-[200px] min-[900px]:shrink-0">
        <div class="min-[900px]:sticky min-[900px]:top-4">
          <Filter client:load total={entri.length} />
        </div>
      </div>

      <ul id="daftar-layanan" class="flex flex-1 list-none flex-col gap-[10px] p-0">
        {entri.map((item) => (
          <BarisEntri entry={item} />
        ))}
      </ul>
    </div>
  </div>
</Base>
