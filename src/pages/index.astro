---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BarisEntri from "../components/BarisEntri.astro";

const semuaEntri = await getCollection("layanan");
const entri = [...semuaEntri].sort((a, b) => a.data.harga_min - b.data.harga_min);

const tanggalTerbaru = entri.reduce<Date | null>((terbaru, item) => {
  const t = item.data.last_verified;
  return !terbaru || t > terbaru ? t : terbaru;
}, null);
---

<Base
  title="Daftar layanan"
  description="Layanan kesehatan mental terjangkau di Bandung beserta biayanya."
>
  <div class="space-y-6">
    <div class="space-y-3">
      <h1 class="font-display text-[32px] font-medium leading-tight text-tinta">
        Daftar layanan
      </h1>
      <p class="max-w-[60ch] text-base font-normal leading-relaxed text-tinta">
        Layanan kesehatan mental di Bandung beserta biayanya.
      </p>
      <p class="font-data text-xs font-normal tracking-normal text-redup">
        {entri.length} layanan
        {tanggalTerbaru &&
          ` · diperbarui ${tanggalTerbaru.getDate()}/${tanggalTerbaru.getMonth() + 1}/${tanggalTerbaru.getFullYear()}`}
      </p>
    </div>

    <ul class="flex list-none flex-col gap-[10px] p-0">
      {entri.map((item) => (
        <BarisEntri entry={item} />
      ))}
    </ul>
  </div>
</Base>
