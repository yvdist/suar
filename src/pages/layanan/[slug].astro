---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import StempelVerifikasi from "../../components/StempelVerifikasi.astro";
import { formatHarga } from "../../lib/harga";
import {
  tautanTelepon,
  tautanWhatsapp,
  tampilanSitus,
  tautanPeta,
  kalimatCaraDatang,
  deskripsiSingkat,
} from "../../lib/kontak";

export const getStaticPaths = (async () => {
  const semuaEntri = await getCollection("layanan");
  return semuaEntri.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<"layanan">;
}

const { entry } = Astro.props;
const data = entry.data;

const labelJenis: Record<string, string> = {
  psikolog: "Psikolog",
  psikiater: "Psikiater",
  konseling: "Konseling",
  komunitas: "Komunitas",
  hotline: "Hotline",
};

const namaJenis = labelJenis[data.jenis] ?? data.jenis;
const lokasi = [data.kota, data.kecamatan].filter(Boolean).join(", ");
const subjudul = [namaJenis, lokasi].filter(Boolean).join(" · ");
const harga = formatHarga(data);

const judulHalaman = `${data.nama} — biaya dan cara mendaftar`;

const labelSkema: Record<string, string> = {
  gratis: "Gratis",
  bpjs: "Ditanggung BPJS",
  "sliding-scale": "Sliding scale",
  "tarif-tetap": "Tarif tetap",
};

const kalimatDatang = kalimatCaraDatang(
  data.online,
  data.tatap_muka,
  data.perlu_rujukan,
  data.perlu_janji,
);

const adaKontak = Boolean(data.telepon ?? data.whatsapp ?? data.situs ?? data.instagram);
const judulBagian =
  "font-data text-[11px] font-normal uppercase tracking-[0.08em] text-redup";
---

<Base title={judulHalaman} description={deskripsiSingkat(data.nama, namaJenis, data.kota, harga)}>
  <div class="space-y-6">
    <a
      id="kembali"
      href="/"
      class="inline-flex min-h-[44px] items-center gap-2 text-sm font-normal text-aksen no-underline hover:underline hover:underline-offset-4"
    >
      <span aria-hidden="true">←</span> Kembali ke daftar
    </a>

    <div class="space-y-2">
      <h1 class="font-display text-[32px] font-medium leading-tight text-tinta">
        {data.nama}
      </h1>
      {subjudul && (
        <p class="text-sm font-normal leading-relaxed text-redup">{subjudul}</p>
      )}
    </div>

    <section aria-labelledby="bagian-biaya" class="space-y-2">
      <h2 id="bagian-biaya" class={judulBagian}>Biaya</h2>
      <p class="text-base font-normal leading-relaxed text-tinta">
        {harga} · {labelSkema[data.skema_biaya] ?? data.skema_biaya}
      </p>
    </section>

    <section aria-labelledby="bagian-cara" class="space-y-2">
      <h2 id="bagian-cara" class={judulBagian}>Cara datang</h2>
      {kalimatDatang.map((kalimat) => (
        <p class="text-base font-normal leading-relaxed text-tinta">{kalimat}</p>
      ))}
      {data.jam_layanan && (
        <p class="text-base font-normal leading-relaxed text-tinta">{data.jam_layanan}</p>
      )}
    </section>

    {adaKontak && (
      <section aria-labelledby="bagian-kontak" class="space-y-2">
        <h2 id="bagian-kontak" class={judulBagian}>Kontak</h2>
        <dl class="space-y-2 text-base font-normal text-tinta">
          {data.telepon && (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-sm font-normal text-redup">Telepon</dt>
              <dd>
                <a href={tautanTelepon(data.telepon)} class="text-aksen underline underline-offset-4">
                  {data.telepon}
                </a>
              </dd>
            </div>
          )}
          {data.whatsapp && (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-sm font-normal text-redup">WhatsApp</dt>
              <dd>
                <a href={tautanWhatsapp(data.whatsapp)} class="text-aksen underline underline-offset-4">
                  {data.whatsapp}
                </a>
              </dd>
            </div>
          )}
          {data.situs && (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-sm font-normal text-redup">Situs</dt>
              <dd>
                <a
                  href={data.situs}
                  rel="noopener"
                  class="break-all text-aksen underline underline-offset-4"
                >
                  {tampilanSitus(data.situs)}
                </a>
              </dd>
            </div>
          )}
          {data.instagram && (
            <div class="flex gap-4">
              <dt class="w-20 shrink-0 text-sm font-normal text-redup">Instagram</dt>
              <dd class="text-tinta">@{data.instagram}</dd>
            </div>
          )}
        </dl>
      </section>
    )}

    {data.alamat && (
      <section aria-labelledby="bagian-alamat" class="space-y-2">
        <h2 id="bagian-alamat" class={judulBagian}>Alamat</h2>
        <p class="text-base font-normal leading-relaxed text-tinta">{data.alamat}</p>
        <p>
          <a
            href={tautanPeta(data.alamat, data.kota)}
            rel="noopener"
            class="inline-flex min-h-[44px] items-center text-sm font-normal text-aksen underline underline-offset-4"
          >
            Buka di peta
          </a>
        </p>
      </section>
    )}

    {data.catatan && (
      <section aria-labelledby="bagian-catatan" class="space-y-2">
        <h2 id="bagian-catatan" class={judulBagian}>Catatan</h2>
        <p class="text-base font-normal leading-relaxed text-tinta">{data.catatan}</p>
      </section>
    )}

    <footer class="space-y-3">
      <StempelVerifikasi lastVerified={data.last_verified} />
      <p class="font-data text-[11px] font-normal tracking-[0.03em] text-redup">
        Sumber: {data.sumber}
      </p>
      <p>
        <a
          href="/lapor"
          class="inline-flex min-h-[44px] items-center gap-1 text-sm font-normal text-aksen underline underline-offset-4"
        >
          Ada yang tidak sesuai? Beri tahu kami <span aria-hidden="true">→</span>
        </a>
      </p>
    </footer>
  </div>
</Base>

<script>
  const kembali = document.getElementById("kembali");
  if (kembali instanceof HTMLAnchorElement) {
    kembali.addEventListener("click", (e) => {
      try {
        const perujuk = new URL(document.referrer);
        if (perujuk.origin === window.location.origin) {
          e.preventDefault();
          window.history.back();
        }
      } catch {
        // referrer kosong atau tidak valid — biarkan tautan ke / bekerja
      }
    });
  }
</script>
