{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "suar",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"previews": {}
}
